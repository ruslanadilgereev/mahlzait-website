---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import { calculatorPageConfig } from "utils/storeLinkConfigs";
import WasserbedarfsRechnerPage from "@modules/wasserbedarf";
import { faq } from "@modules/wasserbedarf/faq";

const seo = {
  title: "Wasserbedarfs-Rechner - Täglichen Wasserbedarf berechnen | Mahlzait",
  description:
    "Wie viel Wasser solltest du am Tag trinken? Trinkmenge nach Alter mit den Richtwerten der DGE berechnen, dazu Sport und Hitze. Kostenlos und mit Quellen.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const howToSchema = {
      "@context": "https://schema.org",
      "@type": "HowTo",
      name: "Wasserbedarf berechnen",
      description: "Berechne deine Trinkmenge pro Tag in 3 einfachen Schritten",
      step: [
        {
          "@type": "HowToStep",
          name: "Alter eingeben",
          text: "Gib dein Alter in Jahren ein (z. B. 40 Jahre), die DGE staffelt ihre Richtwerte nach Alter",
        },
        {
          "@type": "HowToStep",
          name: "Schwanger oder stillend angeben",
          text: "Für Schwangere und Stillende nennt die DGE eigene Richtwerte",
        },
        {
          "@type": "HowToStep",
          name: "Tag auswählen",
          text: "Wähle einen normalen Tag, 1 oder 2 Stunden Sport oder einen Hitzetag",
        },
      ],
    };

const schema0 = {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: "Wasserbedarfs-Rechner",
      headline: "Wasserbedarfs-Rechner - Täglichen Wasserbedarf berechnen",
      description: "Kostenloser Wasserbedarfs-Rechner: Trinkmenge pro Tag nach Alter mit den Richtwerten der DGE für die Wasserzufuhr, dazu Sport und Hitze.",
      mainContentOfPage: {
        "@type": "WebPageElement",
        cssSelector: ".card"
      },
      about: {
        "@type": "Thing",
        name: "Wasserbedarf",
        description: "Wie viel Wasser ein Mensch am Tag braucht und wie viel davon er trinken sollte"
      }
    };

const authorPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.mahlzait.de/#person-ruslan",
  name: "Ruslan Adilgereev",
  url: "https://www.mahlzait.de/team",
  jobTitle: "Founder",
  worksFor: {
    "@type": "Organization",
    name: "Mahlzait",
    url: "https://www.mahlzait.de",
  },
  sameAs: [
    "https://www.linkedin.com/in/ruslanadilgereev",
  ],
};

---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData config={defaultTemplateConfig} type="page" pageTitle="Wasserbedarfs-Rechner" />

  <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(authorPersonSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HowTo Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <!-- WebPage Schema for health content -->
  <script type="application/ld+json" set:html={JSON.stringify(schema0)} />

  <WasserbedarfsRechnerPage client:load config={calculatorPageConfig} />
</Layout>
