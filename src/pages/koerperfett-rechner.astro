---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import configWithoutLegal from "utils/configWithoutLegal";
import KoerperfettRechnerPage from "@modules/koerperfett";

const seo = {
  title: "Körperfettanteil berechnen: KFA-Rechner mit Navy-Formel | Mahlzait",
  description:
    "Körperfettanteil mit Maßband berechnen: US-Navy-Formel offen erklärt, gesunde Bereiche nach Alter und Geschlecht, Genauigkeit im Vergleich zu DEXA, Caliper und Waage.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was ist ein gesunder Körperfettanteil?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Das hängt von Alter und Geschlecht ab. Für Männer zwischen 20 und 39 gelten 8 bis 20 % als gesund, für Frauen im gleichen Alter 21 bis 33 %. Mit jedem Lebensjahrzehnt verschiebt sich der Bereich um etwa zwei Prozentpunkte nach oben (Gallagher et al. 2000).",
      },
    },
    {
      "@type": "Question",
      name: "Wie genau ist die US-Navy-Methode?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "In Vergleichsstudien liegt die Abweichung zur DEXA-Messung bei etwa 3 bis 4 Prozentpunkten. Für die Verlaufskontrolle reicht das, solange immer gleich gemessen wird.",
      },
    },
    {
      "@type": "Question",
      name: "Warum ist der Körperfettanteil bei Frauen höher?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Frauen haben mehr essentielles Fett für Hormonhaushalt und Fortpflanzung: etwa 10 bis 13 % gegenüber 2 bis 5 % bei Männern.",
      },
    },
    {
      "@type": "Question",
      name: "Wie schnell kann man Körperfett verlieren?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Realistisch sind 0,5 bis 1 Prozentpunkt pro Monat bei einem Defizit von 300 bis 500 kcal am Tag. Schneller geht es nur mit Muskelverlust.",
      },
    },
    {
      "@type": "Question",
      name: "Reicht eine Körperfettwaage nicht?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Körperfettwaagen messen den elektrischen Widerstand, der mit dem Wasserhaushalt schwankt. Umfangsmessung und Waage sind ähnlich genau, die Umfänge sind reproduzierbarer.",
      },
    },
  ],
};

const howToSchema = {
      "@context": "https://schema.org",
      "@type": "HowTo",
      name: "Körperfettanteil berechnen",
      description: "Berechne deinen Körperfettanteil mit der US Navy Methode in 4 einfachen Schritten",
      step: [
        {
          "@type": "HowToStep",
          name: "Geschlecht wählen",
          text: "Wähle dein Geschlecht (Mann oder Frau), da die Berechnung unterschiedliche Formeln verwendet",
        },
        {
          "@type": "HowToStep",
          name: "Körpermasse eingeben",
          text: "Gib deine Körpergrösse in cm und dein Gewicht in kg ein",
        },
        {
          "@type": "HowToStep",
          name: "Halsumfang messen",
          text: "Miss deinen Halsumfang direkt unterhalb des Kehlkopfs mit einem Massband",
        },
        {
          "@type": "HowToStep",
          name: "Bauchumfang messen",
          text: "Miss deinen Bauchumfang auf Nabelhöhe (Männer) oder an der schmalsten Stelle (Frauen). Frauen messen zusätzlich den Hüftumfang.",
        },
      ],
    };

const schema0 = {
      "@context": "https://schema.org",
      "@type": "MedicalWebPage",
      name: "Körperfettanteil Rechner",
      headline: "Körperfettanteil berechnen: KFA-Rechner mit Navy-Formel",
      description: "Körperfettanteil mit der US-Navy-Umfangsformel berechnen, mit gesunden Bereichen nach Alter und Geschlecht.",
      medicalAudience: {
        "@type": "MedicalAudience",
        audienceType: "Patient"
      },
      mainContentOfPage: {
        "@type": "WebPageElement",
        cssSelector: ".card"
      }
    };

const authorPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.mahlzait.de/#person-ruslan",
  name: "Ruslan Adilgereev",
  url: "https://www.mahlzait.de/team",
  jobTitle: "Founder",
  worksFor: {
    "@type": "Organization",
    name: "Mahlzait",
    url: "https://www.mahlzait.de",
  },
  sameAs: [
    "https://www.linkedin.com/in/ruslanadilgereev",
  ],
};

---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData config={defaultTemplateConfig} type="page" pageTitle="Körperfettanteil berechnen" />

  <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(authorPersonSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HowTo Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <!-- MedicalWebPage Schema for health content -->
  <script type="application/ld+json" set:html={JSON.stringify(schema0)} />

  <KoerperfettRechnerPage client:load config={configWithoutLegal} />
</Layout>
