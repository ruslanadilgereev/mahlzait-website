---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import { calculatorPageConfig } from "utils/storeLinkConfigs";
import KaloriendefizitPage from "@modules/kaloriendefizit";
import { kaloriendefizitFaq } from "@modules/kaloriendefizit/content";

const seo = {
  title: "Kaloriendefizit berechnen: kostenloser Rechner | Mahlzait",
  description:
    "Berechne dein ideales Kaloriendefizit zum Abnehmen: Der kostenlose Rechner zeigt deinen Tagesbedarf, dein Defizit und wann du dein Zielgewicht erreichst.",
};

// Dieselben Fragen wie in der sichtbaren FAQ der Seite (src/modules/kaloriendefizit/content.ts).
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: kaloriendefizitFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const howToSchema = {
      "@context": "https://schema.org",
      "@type": "HowTo",
      name: "Im Kaloriendefizit abnehmen",
      description: "So erreichst du dein Zielgewicht mit einem Kaloriendefizit",
      step: [
        {
          "@type": "HowToStep",
          name: "Kalorienbedarf ermitteln",
          text: "Berechne deinen täglichen Gesamtbedarf (TDEE) mit dem Rechner",
        },
        {
          "@type": "HowToStep",
          name: "Defizit festlegen",
          text: "Wähle ein Defizit von 300-500 kcal für nachhaltiges Abnehmen",
        },
        {
          "@type": "HowToStep",
          name: "Kalorien tracken",
          text: "Logge deine Mahlzeiten täglich um im Defizit zu bleiben",
        },
        {
          "@type": "HowToStep",
          name: "Geduld haben",
          text: "Bleib 2-4 Wochen konstant und beobachte den Wochendurchschnitt",
        },
      ],
    };

const authorPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.mahlzait.de/#person-ruslan",
  name: "Ruslan Adilgereev",
  url: "https://www.mahlzait.de/team",
  jobTitle: "Founder",
  worksFor: {
    "@type": "Organization",
    name: "Mahlzait",
    url: "https://www.mahlzait.de",
  },
  sameAs: [
    "https://www.linkedin.com/in/ruslanadilgereev",
  ],
};

---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData config={defaultTemplateConfig} type="page" pageTitle="Kaloriendefizit berechnen" />

  <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(authorPersonSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HowTo Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <KaloriendefizitPage client:load config={calculatorPageConfig} />
</Layout>

