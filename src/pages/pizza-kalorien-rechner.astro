---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import { calculatorPageConfig } from "utils/storeLinkConfigs";
import PizzaKalorienRechnerPage from "@modules/pizza";
import { auswahl, berechne, gerundet, groessen, pizzaGramm, zahl } from "@modules/pizza/rechnung";
import { faq } from "@modules/pizza/faq";

// Zahlen aus der Rechnung in Gramm (Werte je 100 g aus USDA FoodData Central)
const margherita = gerundet(berechne(auswahl("margherita", "medium", "classic", [], 8)).ganz);
const howToName: Record<string, string> = { small: "klein", medium: "normal", large: "groß", family: "Familienpizza" };
const groessenText = groessen.map((g) => `${howToName[g.id]} (${g.durchmesser} cm, ${zahl(Math.round(pizzaGramm(g.id)))} g)`);

const seo = {
  title: "Pizza Kalorien Rechner - Margherita, Salami & mehr berechnen | Mahlzait",
  description:
    "Berechne die Kalorien in deiner Pizza. Kostenloser Pizza-Kalorien-Rechner für Margherita, Salami, Hawaii & mehr. Mit Größe, Teigart und Belägen. Inkl. Kalorientabelle.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};

const howToSchema = {
      "@context": "https://schema.org",
      "@type": "HowTo",
      name: "Pizza-Kalorien berechnen",
      description: "Berechne die Kalorien in deiner Pizza mit allen Optionen",
      step: [
        {
          "@type": "HowToStep",
          name: "Pizza-Größe wählen",
          text: `Wähle zwischen ${groessenText.slice(0, -1).join(", ")} oder ${groessenText[groessenText.length - 1]}`,
        },
        {
          "@type": "HowToStep",
          name: "Pizza-Sorte auswählen",
          text: "Wähle deine Pizza: Margherita, Salami, Hawaii, Quattro Formaggi und mehr",
        },
        {
          "@type": "HowToStep",
          name: "Teigart bestimmen",
          text: "Wähle klassischen, dünnen oder dicken Boden, Käserand oder Vollkorn",
        },
        {
          "@type": "HowToStep",
          name: "Extra-Beläge hinzufügen",
          text: "Füge optional Extra-Käse, Pepperoni-Salami, Pilze oder andere Beläge hinzu, jeweils mit fester Menge in Gramm",
        },
        {
          "@type": "HowToStep",
          name: "Anzahl Stücke angeben",
          text: "Gib an, wie viele Stücke du isst",
        },
        {
          "@type": "HowToStep",
          name: "Ergebnis ablesen",
          text: "Die Gesamtkalorien werden mit Gewicht, Protein, Kohlenhydraten und Fett angezeigt",
        },
      ],
    };

const schema0 = {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: "Pizza Kalorien Rechner",
      description: "Kostenloser Online-Rechner für die Kalorien in Pizza: alle Sorten, Größen und Beläge, gerechnet in Gramm mit Werten aus USDA FoodData Central",
      applicationCategory: "HealthApplication",
      operatingSystem: "Web",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "EUR"
      },
      featureList: [
        "Berechnung für 10 Pizza-Sorten",
        "Vier Größen von 26 bis 45 cm mit Gewicht in Gramm",
        "Teigart und Extra-Beläge mit Mengen in Gramm",
        "Anzeige von Gewicht, Protein, Kohlenhydraten und Fett",
        "Kalorientabelle für alle Sorten",
        "Tipps für kalorienärmere Pizza-Optionen",
        "Werte je 100 g aus USDA FoodData Central"
      ]
    };

const schema1 = {
      "@context": "https://schema.org",
      "@type": "NutritionInformation",
      name: "Pizza Margherita (ganze Pizza, 30 cm)",
      servingSize: `${margherita.gramm}g`,
      calories: `${margherita.kcal} kcal`,
      proteinContent: `${margherita.protein}g`,
      carbohydrateContent: `${margherita.kh}g`,
      fatContent: `${margherita.fett}g`
    };

const authorPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.mahlzait.de/#person-ruslan",
  name: "Ruslan Adilgereev",
  url: "https://www.mahlzait.de/team",
  jobTitle: "Founder",
  worksFor: {
    "@type": "Organization",
    name: "Mahlzait",
    url: "https://www.mahlzait.de",
  },
  sameAs: [
    "https://www.linkedin.com/in/ruslanadilgereev",
  ],
};

---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData config={defaultTemplateConfig} type="page" pageTitle="Pizza Kalorien Rechner" />

  <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(authorPersonSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HowTo Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <!-- WebApplication Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema0)} />

  <!-- NutritionInformation Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema1)} />

  <PizzaKalorienRechnerPage client:load config={calculatorPageConfig} />
</Layout>
