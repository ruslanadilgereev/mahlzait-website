---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import configWithoutLegal from "utils/configWithoutLegal";
import KalorienverbrauchJoggenPage from "@modules/joggen";

const seo = {
  title: "Kalorienverbrauch beim Joggen berechnen: Rechner nach Gewicht und Tempo | Mahlzait",
  description:
    "Wie viele Kalorien verbrennt Joggen? 75 kg, 30 Minuten, 10 km/h: rund 375 kcal. Rechner mit MET-Werten aus dem Compendium of Physical Activities, brutto und netto, Tabelle nach Gewicht und Tempo.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Wie viele Kalorien verbrennt man bei 30 Minuten Joggen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Bei 75 kg und 10 km/h rund 375 kcal brutto, etwa 340 kcal netto. Mit 60 kg sind es 300 kcal, mit 90 kg 450 kcal. Das Gewicht wirkt fast proportional, das Tempo weniger stark.",
      },
    },
    {
      "@type": "Question",
      name: "Wie viele Kalorien verbrennt 1 km Joggen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Als Faustregel etwa 1 kcal pro Kilogramm Körpergewicht und Kilometer, bei 75 kg also 75 kcal. Der Wert ist vom Tempo weitgehend unabhängig.",
      },
    },
    {
      "@type": "Question",
      name: "Was ist der Unterschied zwischen brutto und netto?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Brutto ist der gesamte Verbrauch während des Laufens. Netto zieht den Ruheumsatz ab, etwa 1 kcal pro kg und Stunde. Für die Kalorienbilanz zählt netto; Sportuhren zeigen meist brutto.",
      },
    },
    {
      "@type": "Question",
      name: "Warum zeigt meine Sportuhr einen anderen Wert?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Uhren schätzen über die Herzfrequenz, die auf Hitze, Schlafmangel und Koffein reagiert. In Vergleichsstudien lagen die Abweichungen bei 15 bis 30 Prozent. Die MET-Rechnung ist reproduzierbar.",
      },
    },
    {
      "@type": "Question",
      name: "Wie viel muss ich joggen, um ein Kilo Fett zu verlieren?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ein Kilogramm Körperfett entspricht etwa 7.000 kcal. Bei rund 340 kcal netto pro 30-Minuten-Lauf sind das etwa 21 Läufe bei gleichbleibender Ernährung.",
      },
    },
  ],
};

const authorPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.mahlzait.de/#person-ruslan",
  name: "Ruslan Adilgereev",
  url: "https://www.mahlzait.de/team",
  jobTitle: "Founder",
  worksFor: {
    "@type": "Organization",
    name: "Mahlzait",
    url: "https://www.mahlzait.de",
  },
  sameAs: ["https://www.linkedin.com/in/ruslanadilgereev"],
};
---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData config={defaultTemplateConfig} type="page" pageTitle="Kalorienverbrauch beim Joggen berechnen" />
  <script type="application/ld+json" set:html={JSON.stringify(authorPersonSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <KalorienverbrauchJoggenPage client:load config={configWithoutLegal} />
</Layout>
