---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import configWithoutLegal from "utils/configWithoutLegal";
import YazioAlternativePage from "@modules/yazioAlternative";

const seo = {
  title: "Yazio Alternative 2026: Kosten, Kündigung & Vergleich | Mahlzait",
  description:
    "Was kostet Yazio Pro wirklich, wie kündigst du dein Abo und welche Alternative passt zu dir? Ehrlicher Vergleich mit Preisen, Stärken und Schwächen beider Apps.",
};

const siteUrl = "https://www.mahlzait.de";
const pageUrl = `${siteUrl}/yazio-alternative/`;
const priceAsOf = "August 2026";

// Preise aus derselben Quelle wie /vergleich/, Anbieterangaben, keine Aktionspreise.
const pricing = [
  { app: "Mahlzait", free: "Unbegrenzt tracken, ohne Werbung", pro: "4,99 €/Monat oder 29,99 €/Jahr" },
  { app: "Yazio", free: "Basis-Tracking", pro: "ab 6,99 €/Monat" },
  { app: "Lifesum", free: "Basis-Tracking", pro: "ab 8,99 €/Monat" },
  { app: "MyFitnessPal", free: "Sehr eingeschränkt", pro: "ab 9,99 €/Monat" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was kostet Yazio Pro?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Die Basisversion von Yazio ist kostenlos und reicht zum Kalorienzählen aus. Yazio Pro beginnt laut Anbieterangaben bei etwa 6,99 € pro Monat (Stand ${priceAsOf}), im Jahresabo entsprechend günstiger. Yazio wirbt regelmäßig mit Rabatten, und über den App Store können die Beträge abweichen. Der verbindliche Preis steht immer in der App.`,
      },
    },
    {
      "@type": "Question",
      name: "Wie kündige ich mein Yazio-Abo?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Gekündigt wird dort, wo bezahlt wurde. Auf dem iPhone über Einstellungen, den eigenen Namen und Abonnements. Auf Android über den Google Play Store, das Profilbild, Zahlungen und Abos. Wurde direkt bei Yazio gebucht, erfolgt die Kündigung nach dem Login auf yazio.com unter Konto und Abonnement. Wichtig: Die App zu löschen beendet das Abo nicht.",
      },
    },
    {
      "@type": "Question",
      name: "Ist Yazio eine gute App?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja. Yazio hat im deutschen App Store über 435.000 Bewertungen bei einem Schnitt von 4,6 Sternen, eine sehr große Lebensmitteldatenbank, eine umfangreiche Rezeptwelt und einen integrierten Fastentracker. Wer eine Alternative sucht, stört sich meist nicht an der Qualität, sondern am Abopreis oder daran, dass das Suchen und Auswählen jeder Mahlzeit zu lange dauert.",
      },
    },
    {
      "@type": "Question",
      name: "Was unterscheidet Mahlzait von Yazio?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der Unterschied liegt in der Eingabe. Bei Yazio suchst du Lebensmittel in einer gepflegten Datenbank. Bei Mahlzait beschreibst du die Mahlzeit als Text oder fotografierst sie, und unbekannte Produkte werden live im Web recherchiert, mit Quellenangabe zu jedem Eintrag, sodass die Zahl nachprüfbar ist. Yazio bleibt bei Rezepten, Ernährungsplänen und Fastentracking im Vorteil.",
      },
    },
    {
      "@type": "Question",
      name: "Gehen meine Daten beim Wechsel verloren?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Deine bisherigen Yazio-Einträge bleiben in deinem Yazio-Konto erhalten, auch nach einer Kündigung. Ein automatischer Import in Mahlzait ist nicht vorgesehen; für das laufende Tracking reicht es, Körperdaten und Ziel neu zu setzen, was in wenigen Minuten erledigt ist.",
      },
    },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Yazio Alternative", item: pageUrl },
  ],
};
---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData
    config={defaultTemplateConfig}
    type="page"
    pageTitle="Yazio Alternative"
    pageDescription={seo.description}
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <YazioAlternativePage
    client:load
    config={configWithoutLegal}
    pricing={pricing}
    priceAsOf={priceAsOf}
  />
</Layout>
