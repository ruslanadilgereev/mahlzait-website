---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import configWithoutLegal from "utils/configWithoutLegal";
import DoenerKalorienRechnerPage from "@modules/doener";

const seo = {
  title: "Wie viele Kalorien hat ein Döner? Alle Varianten im Vergleich | Mahlzait",
  description:
    "Döner Kebab mit Kalb: rund 650 kcal, Hähnchen 550, Dürüm 700, Döner-Box bis 1.000. Tabelle mit Portionsgewicht, Eiweiß, Kohlenhydraten und Fett, dazu ein Rechner für deinen Döner.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie viele Kalorien hat ein normaler Döner?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ein klassischer Döner Kebab im Fladenbrot mit Kalbfleisch hat rund 650 kcal bei etwa 350 g, je nach Imbiss 550 bis 750. Mit Hähnchen und Joghurtsoße sind es etwa 550 kcal."
      }
    },
    {
      "@type": "Question",
      "name": "Wie viele Kalorien hat ein Dürüm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ein Dürüm liegt bei rund 700 kcal für 400 g. Der Yufka-Teig ist leichter als Fladenbrot, aber die Rolle fasst mehr Fleisch und Soße."
      }
    },
    {
      "@type": "Question",
      "name": "Was hat weniger Kalorien: Döner oder Dürüm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Der Döner, aber nur knapp: 650 gegenüber 700 kcal. Entscheidender als die Hülle sind Fleischsorte und Soße."
      }
    },
    {
      "@type": "Question",
      "name": "Wie viel Eiweiß hat ein Döner?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "35 bis 40 g, hauptsächlich aus dem Fleisch. Ein Hähnchen-Döner liegt am oberen Ende."
      }
    },
    {
      "@type": "Question",
      "name": "Hat ein Döner mehr Kalorien als ein Big Mac?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Ein Big Mac hat 503 kcal, ein Kalb-Döner rund 650. Der Döner liefert dafür 35 g Eiweiß statt 26 g und deutlich mehr Gemüse."
      }
    },
    {
      "@type": "Question",
      "name": "Was ist die kalorienärmste Döner-Variante?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Der Döner-Teller mit Salat, ohne Brot, Reis und Pommes, mit Hähnchen und Joghurtsoße: 350 bis 450 kcal bei 35 g Eiweiß."
      }
    },
    {
      "@type": "Question",
      "name": "Wie viele Kalorien hat eine Döner-Box?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "800 bis 1.000 kcal. Pommes, Fleisch und Soße ohne den Salatanteil des Fladenbrots machen sie zur schwersten Variante."
      }
    }
  ]
};

const howToSchema = {
      "@context": "https://schema.org",
      "@type": "HowTo",
      name: "Döner-Kalorien berechnen",
      description: "Berechne die Kalorien in deinem Döner Kebab mit allen Zutaten",
      step: [
        {
          "@type": "HowToStep",
          name: "Döner-Art auswählen",
          text: "Wähle zwischen klassischem Döner, Dürüm, Döner Box, Lahmacun oder Pide",
        },
        {
          "@type": "HowToStep",
          name: "Fleisch wählen",
          text: "Wähle Kalb, Hähnchen, gemischt oder Lamm – oder vegetarisch mit Falafel",
        },
        {
          "@type": "HowToStep",
          name: "Sauce und Extras hinzufügen",
          text: "Füge Saucen wie Joghurt, Knoblauch oder Cocktail hinzu, sowie optionale Extras",
        },
        {
          "@type": "HowToStep",
          name: "Ergebnis ablesen",
          text: "Die Gesamtkalorien werden mit Protein, Kohlenhydraten und Fett angezeigt",
        },
      ],
    };

const schema0 = {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: "Döner Kalorien Rechner",
      description: "Kostenloser Online-Rechner zur Berechnung der Kalorien in Döner Kebab, Dürüm und Lahmacun",
      applicationCategory: "HealthApplication",
      operatingSystem: "Web",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "EUR"
      },
      featureList: [
        "Berechnung der Kalorien für verschiedene Döner-Arten",
        "Auswahl von Fleisch, Sauce und Extras",
        "Anzeige von Protein, Kohlenhydraten und Fett",
        "Kalorientabelle für alle Döner-Varianten",
        "Tipps für kalorienärmere Döner-Optionen"
      ]
    };

const schema1 = {
      "@context": "https://schema.org",
      "@type": "NutritionInformation",
      name: "Döner Kebab (klassisch)",
      servingSize: "350g",
      calories: "650 kcal",
      proteinContent: "35g",
      carbohydrateContent: "50g",
      fatContent: "32g"
    };

const authorPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.mahlzait.de/#person-ruslan",
  name: "Ruslan Adilgereev",
  url: "https://www.mahlzait.de/team",
  jobTitle: "Founder",
  worksFor: {
    "@type": "Organization",
    name: "Mahlzait",
    url: "https://www.mahlzait.de",
  },
  sameAs: [
    "https://www.linkedin.com/in/ruslanadilgereev",
  ],
};

---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData config={defaultTemplateConfig} type="page" pageTitle="Wie viele Kalorien hat ein Döner?" />

  <!-- FAQPage Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(authorPersonSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HowTo Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <!-- WebApplication Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema0)} />

  <!-- NutritionInformation Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema1)} />

  <DoenerKalorienRechnerPage client:load config={configWithoutLegal} />
</Layout>
