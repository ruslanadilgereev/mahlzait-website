---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import configWithoutLegal from "utils/configWithoutLegal";
import LeistungsumsatzRechnerPage from "@modules/leistungsumsatz";

const seo = {
  title: "Leistungsumsatz berechnen: Rechner mit PAL-Wert | Mahlzait",
  description:
    "Berechne deinen Leistungsumsatz kostenlos: Grundumsatz mal PAL-Faktor. Mit PAL-Tabelle nach DGE, Beispielrechnungen und Tipps für mehr Kalorienverbrauch.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was ist der Leistungsumsatz?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der Leistungsumsatz ist die Energie, die dein Körper zusätzlich zum Grundumsatz für alle Aktivitäten verbraucht: Arbeit, Sport, Haushalt und Alltagsbewegung. Grundumsatz plus Leistungsumsatz ergeben den Gesamtumsatz.",
      },
    },
    {
      "@type": "Question",
      name: "Wie berechnet man den Leistungsumsatz?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Leistungsumsatz = Grundumsatz × (PAL − 1). Beispiel: Bei 1.700 kcal Grundumsatz und Büroarbeit (PAL 1,45) beträgt der Leistungsumsatz 765 kcal, der Gesamtumsatz 2.465 kcal.",
      },
    },
    {
      "@type": "Question",
      name: "Was ist der PAL-Wert?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "PAL steht für Physical Activity Level. Die DGE-Referenzwerte reichen von 1,2 (nur sitzend/liegend) über 1,4-1,5 (Büro) bis 2,0-2,4 (körperlich harte Arbeit oder Leistungssport).",
      },
    },
    {
      "@type": "Question",
      name: "Was ist der Unterschied zwischen Grundumsatz, Leistungsumsatz und Gesamtumsatz?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Der Grundumsatz ist das Energieminimum in völliger Ruhe, der Leistungsumsatz kommt durch Aktivität dazu, und der Gesamtumsatz ist die Summe aus beiden - die entscheidende Zahl für die Ernährungsplanung.",
      },
    },
    {
      "@type": "Question",
      name: "Wie hoch ist ein typischer Leistungsumsatz?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Eine Büroangestellte mit 1.400 kcal Grundumsatz und PAL 1,45 kommt auf rund 630 kcal Leistungsumsatz, ein Handwerker mit 1.780 kcal Grundumsatz und PAL 1,85 auf etwa 1.510 kcal.",
      },
    },
    {
      "@type": "Question",
      name: "Wie kann ich meinen Leistungsumsatz erhöhen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Am wirksamsten über Alltagsbewegung: Treppen statt Aufzug, 8.000 bis 10.000 Schritte täglich und regelmäßiger Sport. Jede Bewegung zählt direkt in den Leistungsumsatz.",
      },
    },
  ],
};

const authorPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.mahlzait.de/#person-ruslan",
  name: "Ruslan Adilgereev",
  url: "https://www.mahlzait.de/team",
  jobTitle: "Founder",
  worksFor: {
    "@type": "Organization",
    name: "Mahlzait",
    url: "https://www.mahlzait.de",
  },
  sameAs: [
    "https://www.linkedin.com/in/ruslanadilgereev",
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://www.mahlzait.de/" },
    { "@type": "ListItem", "position": 2, "name": "Rechner", "item": "https://www.mahlzait.de/rechner/" },
    { "@type": "ListItem", "position": 3, "name": "Leistungsumsatz-Rechner", "item": "https://www.mahlzait.de/leistungsumsatz-rechner/" }
  ]
};
---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData config={defaultTemplateConfig} type="page" pageTitle="Leistungsumsatz-Rechner" pageDescription={seo.description} />

  <script type="application/ld+json" set:html={JSON.stringify(authorPersonSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <LeistungsumsatzRechnerPage client:load config={configWithoutLegal} />
</Layout>
