---
import Layout from "Layout.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import defaultTemplateConfig from "utils/config";
import configWithoutLegal from "utils/configWithoutLegal";
import FastfoodKalorienPage from "@modules/fastfoodKalorien";
import type { FastFoodItem } from "@modules/fastfoodKalorien";

// Ketten-Daten aus den bestehenden Food-JSONs aggregieren. Die Einzelseiten
// bleiben unveraendert, hier entsteht nur die Uebersicht ueber alle Ketten.
const CHAINS: Record<string, string> = {
  mcdonalds: "McDonald's",
  "burger-king": "Burger King",
  subway: "Subway",
  kfc: "KFC",
  vapiano: "Vapiano",
};

const foodFiles = import.meta.glob("../data/foods/*.json", { eager: true });

interface RawVariant {
  name: string;
  portion_g?: number;
  calories?: number;
  protein?: number;
  carbs?: number;
  fat?: number;
}
interface RawFood {
  slug: string;
  name: string;
  variants?: RawVariant[];
}

const items: FastFoodItem[] = [];
for (const mod of Object.values(foodFiles)) {
  const food = ((mod as { default?: RawFood }).default ?? mod) as RawFood;
  const brand = CHAINS[food.slug];
  if (!brand) continue;
  for (const v of food.variants ?? []) {
    if (typeof v.calories !== "number") continue;
    items.push({
      brand,
      brandSlug: food.slug,
      name: v.name,
      portion_g: v.portion_g ?? null,
      calories: v.calories,
      protein: v.protein ?? null,
      carbs: v.carbs ?? null,
      fat: v.fat ?? null,
    });
  }
}
items.sort((a, b) => a.calories - b.calories);

const brandNames = Array.from(new Set(items.map((i) => i.brand)));
const lowest = items[0];
const highest = items[items.length - 1];

const seo = {
  title: `Fast Food Kalorien: ${items.length} Gerichte im Vergleich | Mahlzait`,
  description: `Kalorien und Eiweiss von ${brandNames.join(", ")} in einer Tabelle. Nach Kalorienbudget filtern und sehen, was bei deiner Lieblingskette wirklich reinpasst.`,
};

const siteUrl = "https://www.mahlzait.de";
const pageUrl = `${siteUrl}/fastfood-kalorien/`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Was kann ich bei McDonald's essen, wenn ich abnehmen will?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Entscheidend ist weniger das einzelne Gericht als die Menü-Kombination. Ein einfacher Burger bleibt meist unter 500 Kalorien, mit großen Pommes und Softdrink verdoppelt sich dieselbe Mahlzeit schnell. Wer im Defizit isst, achtet am besten auf das Verhältnis von Eiweiß zu Kalorien: Gegrilltes Hähnchen und schlichte Burger sättigen bei gleicher Kalorienzahl deutlich besser als panierte Beilagen, Shakes oder Pommes. Die Tabelle auf dieser Seite lässt sich genau danach sortieren.",
      },
    },
    {
      "@type": "Question",
      name: "Welche Fast-Food-Kette hat die wenigsten Kalorien?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Das lässt sich nicht pauschal beantworten, weil jede Kette sowohl sehr leichte als auch sehr schwere Gerichte führt. Aussagekräftiger ist der Vergleich einzelner Gerichte: In dieser Übersicht reicht die Spanne von ${lowest?.calories ?? 0} Kalorien (${lowest?.name ?? ""}, ${lowest?.brand ?? ""}) bis ${highest?.calories ?? 0} Kalorien (${highest?.name ?? ""}, ${highest?.brand ?? ""}). Statt die Kette zu wechseln, lohnt es sich also eher, innerhalb der Karte zu wählen.`,
      },
    },
    {
      "@type": "Question",
      name: "Sind die Kalorienangaben von Fast-Food-Ketten verlässlich?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die Herstellerangaben sind eine gute Orientierung, in der Praxis schwanken die Werte aber. Portionsgrößen variieren je Filiale, Saucen und Toppings sind selten vollständig eingerechnet, und Rezepturen ändern sich. Für das tägliche Tracking reicht die Größenordnung völlig aus; wer es genauer braucht, sollte die Nährwerttabelle der Kette vor Ort prüfen.",
      },
    },
  ],
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Fast Food Kalorien und Naehrwerte",
  description: `Kalorien, Eiweiss, Kohlenhydrate und Fett von ${items.length} Fast-Food-Gerichten der Ketten ${brandNames.join(", ")}, jeweils je Portion.`,
  url: pageUrl,
  license: "https://creativecommons.org/licenses/by/4.0/",
  creator: {
    "@type": "Organization",
    name: "Mahlzait",
    url: siteUrl,
  },
  variableMeasured: ["Kalorien", "Eiweiss", "Kohlenhydrate", "Fett", "Portionsgroesse"],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Fast Food Kalorien", item: pageUrl },
  ],
};
---

<Layout {...defaultTemplateConfig} seo={seo}>
  <StructuredData
    config={defaultTemplateConfig}
    type="page"
    pageTitle="Fast Food Kalorien"
    pageDescription={seo.description}
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <FastfoodKalorienPage client:load config={configWithoutLegal} items={items} />
</Layout>
